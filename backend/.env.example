# StockDone backend production environment
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/stockdone
DEFAULT_BUSINESS_ID=00000000-0000-4000-8000-000000000001
DEFAULT_BRANCH_ID=00000000-0000-4000-8000-000000000002
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional password-reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=
