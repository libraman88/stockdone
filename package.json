{
  "name": "stockdone",
  "version": "0.1.0",
  "private": true,
  "description": "StockDone - Garments POS & Inventory Management",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "electron": "latest",
    "jsbarcode": "^3.11.6",
    "xlsx": "^0.18.5",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "concurrently": "latest",
    "cross-env": "latest",
    "wait-on": "latest",
    "electron-rebuild": "^3.7.2"
  }
}
