{
  "name": "stockdone",
  "version": "0.2.61",
  "private": true,
  "description": "StockDone - Garments POS & Inventory Management",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit",
    "desktop:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "desktop:win:publish": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "jsbarcode": "^3.11.6",
    "xlsx": "^0.18.5",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "wait-on": "latest",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "electron-builder": "^26.15.3",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest"
  },
  "build": {
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "appId": "com.stockdone.pos",
    "productName": "StockDone",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "libraman88",
      "repo": "stockdone",
      "releaseType": "release"
    }
  }
}
